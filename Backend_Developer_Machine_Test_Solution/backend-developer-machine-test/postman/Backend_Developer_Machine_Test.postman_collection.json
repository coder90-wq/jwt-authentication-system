{
  "info": {
    "name": "Backend Developer Machine Test",
    "description": "End-to-end OTP signup, JWT authentication, role checks, logout and product CRUD. Run requests in order. For local demo, use the demoOtp returned by OTP Request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "standardEmail", "value": "demo_user@example.com" },
    { "key": "standardUsername", "value": "demo_user_01" },
    { "key": "restrictedEmail", "value": "restricted_user@example.com" },
    { "key": "standardOtp", "value": "" },
    { "key": "standardToken", "value": "" },
    { "key": "adminEmail", "value": "demo_admin@example.com" },
    { "key": "adminUsername", "value": "demo_admin_01" },
    { "key": "adminOtp", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "productId", "value": "" }
  ],
  "item": [
    {
      "name": "Standard user flow",
      "item": [
        {
          "name": "Signup rejects short username",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"username\": \"short\",\n  \"email\": \"valid_user@example.com\",\n  \"password\": \"Pass@123\",\n  \"userType\": \"Standard User\",\n  \"countryCode\": \"IN\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/auth/signup" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Short username is rejected', () => pm.response.to.have.status(400));"] } }]
        },
        {
          "name": "Signup rejects email without underscore",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"username\": \"valid_user_02\",\n  \"email\": \"valid@example.com\",\n  \"password\": \"Pass@123\",\n  \"userType\": \"Standard User\",\n  \"countryCode\": \"IN\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/auth/signup" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Email without underscore is rejected', () => pm.response.to.have.status(400));"] } }]
        },
        {
          "name": "Signup rejects weak password",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"username\": \"valid_user_03\",\n  \"email\": \"valid_user@example.com\",\n  \"password\": \"Password1\",\n  \"userType\": \"Standard User\",\n  \"countryCode\": \"IN\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/auth/signup" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Weak password is rejected', () => pm.response.to.have.status(400));"] } }]
        },
        {
          "name": "Country restriction blocks Iran",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"username\": \"restricted_user\",\n  \"email\": \"{{restrictedEmail}}\",\n  \"password\": \"Pass@123\",\n  \"userType\": \"Standard User\",\n  \"countryCode\": \"IR\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/auth/signup" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Restricted country is blocked', () => pm.response.to.have.status(403));"] } }]
        },
        {
          "name": "1. Request OTP",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{standardEmail}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/auth/otp/request" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('OTP requested', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('standardOtp', pm.response.json().demoOtp);"] } }]
        },
        {
          "name": "2. Verify OTP",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{standardEmail}}\",\n  \"otp\": \"{{standardOtp}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/auth/otp/verify" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('OTP verified', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "3. Signup (Standard User)",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{standardUsername}}\",\n  \"email\": \"{{standardEmail}}\",\n  \"password\": \"Pass@123\",\n  \"userType\": \"Standard User\",\n  \"countryCode\": \"IN\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/auth/signup" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Signup created', () => pm.response.to.have.status(201));", "pm.test('Registration message returned', () => pm.expect(pm.response.json().message).to.eql('Registration successful'));"] } }]
        },
        {
          "name": "4. Login",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{standardEmail}}\",\n  \"password\": \"Pass@123\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/auth/login" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Login returns JWT', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('standardToken', pm.response.json().token);"] } }]
        },
        {
          "name": "Invalid login",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{standardEmail}}\",\n  \"password\": \"Wrong@123\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/auth/login" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Invalid login is rejected', () => pm.response.to.have.status(401));", "pm.expect(pm.response.json().message).to.eql('Login Failed');"] } }]
        },
        {
          "name": "5. Dashboard",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{standardToken}}" }], "url": "{{baseUrl}}/api/dashboard" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Dashboard welcomes user', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().message).to.eql('Welcome ' + pm.collectionVariables.get('standardUsername')); "] } }]
        },
        {
          "name": "6. Settings denied for Standard User",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{standardToken}}" }], "url": "{{baseUrl}}/api/settings" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Standard user is denied settings', () => pm.response.to.have.status(403));", "pm.expect(pm.response.json().message).to.eql('Access Denied');"] } }]
        },
        {
          "name": "7. Create Product",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{standardToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Sample product\",\n  \"description\": \"Machine test product\",\n  \"price\": 19.99\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/products" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Product created', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('productId', pm.response.json().id);"] } }]
        },
        {
          "name": "8. Read Products",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{standardToken}}" }], "url": "{{baseUrl}}/api/products?page=0&size=10&sortBy=id" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Products listed', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().content).to.be.an('array');"] } }]
        },
        {
          "name": "9. Update Product",
          "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{standardToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated sample product\",\n  \"description\": \"Updated description\",\n  \"price\": 24.50\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/products/{{productId}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Product updated', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().name).to.eql('Updated sample product');"] } }]
        },
        {
          "name": "10. Delete Product",
          "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{standardToken}}" }], "url": "{{baseUrl}}/api/products/{{productId}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Product deleted', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "11. Logout",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{standardToken}}" }], "url": "{{baseUrl}}/api/auth/logout" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Logout succeeds', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().message).to.eql(pm.collectionVariables.get('standardUsername') + ' Logged Out');"] } }]
        },
        {
          "name": "12. Dashboard denied after logout",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{standardToken}}" }], "url": "{{baseUrl}}/api/dashboard" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Revoked token is rejected', () => pm.response.to.have.status(401));"] } }]
        }
      ]
    },
    {
      "name": "Administrator access flow",
      "item": [
        {
          "name": "1. Request Admin OTP",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/auth/otp/request" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Admin OTP requested', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('adminOtp', pm.response.json().demoOtp);"] } }]
        },
        {
          "name": "2. Verify Admin OTP",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"otp\": \"{{adminOtp}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/auth/otp/verify" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Admin OTP verified', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "3. Signup Administrator",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"Pass@123\",\n  \"userType\": \"Administrator\",\n  \"countryCode\": \"IN\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/auth/signup" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Admin account created', () => pm.response.to.have.status(201));"] } }]
        },
        {
          "name": "4. Login Administrator",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"Pass@123\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/auth/login" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Admin login returns JWT', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('adminToken', pm.response.json().token);"] } }]
        },
        {
          "name": "5. Settings allowed for Administrator",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/settings" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Administrator can access settings', () => pm.response.to.have.status(200));"] } }]
        }
      ]
    }
  ]
}
